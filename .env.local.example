# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from Neon (neon.tech), Railway, or Render
DATABASE_URL=postgresql://user:password@host:5432/flh_dashboard

# Secret key to protect the /api/scrape endpoint
# Generate a random string, e.g.: openssl rand -base64 32
CRON_SECRET=your-secret-key-here

# Timezone used for recorded_date and "today" windows in APIs
# Example values: Africa/Cairo, Europe/Berlin, Asia/Riyadh, UTC
APP_TIMEZONE=Asia/Tbilisi

# Meta Graph API (Instagram + Facebook). Long-lived Page access token with:
# pages_read_engagement, pages_show_list, instagram_basic
META_ACCESS_TOKEN=

# Facebook Page ID and linked Instagram Business Account ID (Graph API node IDs)
FB_PAGE_ID=
IG_ACCOUNT_ID=
